# Variabel untuk docker compose -f docker-compose.server.yml
# Salin file ini menjadi .env di server, lalu isi nilainya.
# .env tidak di-commit agar kredensial tidak masuk repositori.

# Port di server yang menyajikan aplikasi.
# Pastikan port ini dibuka di firewall, atau taruh di belakang reverse proxy.
APP_PORT=8080

# Alamat yang dipakai browser. Tanpa domain, isi IP publik server.
APP_URL=http://203.0.113.10:8080

# Buat dengan perintah berikut, lalu tempel hasilnya (termasuk awalan "base64:"):
#   docker compose -f docker-compose.server.yml run --rm app php artisan key:generate --show
APP_KEY=

# Kredensial database. Pakai kata sandi acak, misalnya dari `openssl rand -hex 24`.
DB_DATABASE=silakes
DB_USERNAME=silakes
DB_PASSWORD=
DB_ROOT_PASSWORD=

# Set ke true hanya pada start pertama, untuk mengisi data contoh.
# Seeder tidak idempoten, jalankan ulang akan menggandakan data.
SEED_ON_START=false

# Biarkan false selama akses memakai http. Set true setelah HTTPS aktif.
SESSION_SECURE_COOKIE=false

# log = email hanya ditulis ke log container. Ganti ke smtp bila ingin kirim email.
MAIL_MAILER=log